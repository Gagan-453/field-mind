{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(.venv/bin/python *)",
      "Bash(pytest *)",
      "Bash(pip install *)",
      "Bash(adb *)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(curl -s http://localhost:*)"
    ],
    "ask": [
      "Bash(rm *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(adb shell rm *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
